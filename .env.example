# ---------------------------------------------------------------------------
# Mau bien moi truong. Sao chep thanh .env khi chay local (KHONG commit .env).
# Tren Vercel: khai bao trong Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Cong server lang nghe. Local mac dinh 3456. Tren Vercel KHONG dat tay.
PORT=3456

# Mat khau de dang nhap trang giao vien (/teacher).
# Neu de trong: trang giao vien chi truy cap duoc tu localhost (chay local).
TEACHER_PASSWORD=doi-mat-khau-nay-that-manh

# Khoa ky cookie phien giao vien (chuoi ngau nhien dai).
# Neu bo trong, he thong tu dan xuat tu TEACHER_PASSWORD (khuyen nghi dat rieng).
SESSION_SECRET=

# Chuoi ket noi PostgreSQL (tuy chon).
# Bo trong -> chay local: luu file JSON trong data/.
# Bo trong + tren Vercel: du lieu nam trong IndexedDB cua trinh duyet giao vien
# (serverless chi giu ban tam trong /tmp). Xem README muc 4.
# Vi du: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# So ket noi toi da trong pool PostgreSQL (mac dinh 5).
PG_POOL_MAX=5

# production / development
NODE_ENV=production
